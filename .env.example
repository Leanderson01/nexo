# Convex (o `npx convex dev` preenche estes três no .env.local)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# LLM (Groq: um modelo rápido para entender e um principal para agir)
LLM_PROVIDER=groq
LLM_MODEL_FAST=
LLM_MODEL_MAIN=
GROQ_API_KEY=

# Transcrição de voz (Whisper no Groq, mesma chave)
TRANSCRIPTION_PROVIDER=groq
TRANSCRIPTION_MAX_SECONDS=60

# Segredos internos (gere valores aleatórios longos)
AGENT_SERVER_SECRET=
TICKETING_SERVICE_KEY=

# Simulação do sistema legado de chamados
TICKETING_FAILURE_RATE=0.1
TICKETING_LATENCY_MS=200-1500

# Limites
MAX_MESSAGES_PER_CONVERSATION=30
MAX_DAILY_LLM_COST_USD=5
