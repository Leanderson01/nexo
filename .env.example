# Variáveis do Nexo Assist. Há dois lugares:
#
# - [Next]   no .env.local (desenvolvimento) ou no painel da Vercel (deploy): lidas pelo
#            servidor do Next, pelas rotas do chat e pelo runner de evals.
# - [Convex] no deployment do Convex: `npx convex env set NOME valor` (ou no painel). O Convex
#            não lê o .env.local; o que estiver só aqui não chega às funções dele.
# - [ambos]  o mesmo valor nos dois lugares (segredos compartilhados entre o Next e o Convex).

# ---------- Convex [Next] (o `npx convex dev` preenche estes três no .env.local) ----------
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# ---------- Convex Auth [Convex] (não vão no .env.local) ----------
# `npm run setup:auth` gera o par de chaves e grava as três no deployment atual do Convex:
#   JWT_PRIVATE_KEY  chave privada RS256 que assina os tokens da sessão
#   JWKS             chave pública correspondente, para o Convex validar os tokens
#   SITE_URL         endereço do app (padrão http://localhost:3000; no deploy, passe a URL
#                    pública: `npm run setup:auth -- https://...`)

# ---------- LLM [Next] (Groq: um modelo rápido para entender e um principal para agir; ver docs/decisoes/llm.md) ----------
LLM_PROVIDER=groq
LLM_MODEL_FAST=openai/gpt-oss-20b
LLM_MODEL_MAIN=openai/gpt-oss-120b
GROQ_API_KEY=

# ---------- Transcrição de voz [Next] (Whisper no Groq, mesma chave) ----------
TRANSCRIPTION_PROVIDER=groq
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
TRANSCRIPTION_MAX_SECONDS=60

# ---------- Segredos internos [ambos] (gere valores aleatórios longos, ex.: `openssl rand -hex 32`) ----------
# Autoriza o servidor do Next a gravar as mensagens do agent no Convex.
AGENT_SERVER_SECRET=
# Chave da API do serviço de chamados (o "legado" simulado, em convex/ticketing/http.ts).
TICKETING_SERVICE_KEY=
# Só no desenvolvimento: libera o apoio ao `npm run evals` (inclui limpar o banco antes de cada
# cenário). Nunca configure em produção: sem ela, o Convex recusa essas funções.
EVALS_SECRET=

# ---------- Simulação do sistema legado de chamados [Convex] ----------
TICKETING_FAILURE_RATE=0.1
TICKETING_LATENCY_MS=200-1500

# ---------- Limites contra abuso e custo (§12.3) [Convex] ----------
# Ausentes, valem os padrões abaixo.
# O "dia" é o de São Paulo: tudo zera à meia-noite de Brasília. 0 desliga o recurso.
# Mensagens do funcionário por conversa.
MAX_MESSAGES_PER_CONVERSATION=30
# Teto global de custo estimado do LLM por dia, em US$ (~4.000 turnos). Atingido, o agent para
# de responder: a mensagem fica salva e o chat oferece "Falar com um analista".
MAX_DAILY_LLM_COST_USD=5
# Conversas novas por funcionário por dia.
MAX_CONVERSATIONS_PER_DAY=10
# Transcrição de voz por dia (global): segundos de áudio (3600 = 1 h, ~US$ 0,04) e quantidade.
MAX_DAILY_TRANSCRIPTION_SECONDS=3600
MAX_DAILY_TRANSCRIPTIONS=200
